# Copia este archivo a .env y rellena los dos valores.
# .env está en .gitignore: NUNCA se sube al repositorio.
# En GitHub Actions estos dos valores llegan como secrets, no por fichero.

# Bot de Telegram (créalo hablando con @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Canal donde publica. El bot tiene que ser administrador con permiso para
# publicar. Vale el @alias si el canal es público; si es privado hace falta
# el id numérico (algo como -1001234567890), porque la Bot API no resuelve
# el alias de un canal privado.
TELEGRAM_CHANNEL=
